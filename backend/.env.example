# Required
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-string

# Optional — see docs/ENVIRONMENT_VARIABLES.md for full descriptions and defaults
PORT=5000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# AI (defaults to the mock provider — safe with no key configured)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=500
TEMPERATURE=0.7

# Sessions
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000

# Used to build password-reset / email-verification links (defaults to CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173
