generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  AUTHORITY
  ADMINISTRATOR
}

model School {
  id        String   @id @default(cuid())
  name      String
  city      String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  students       Student[]
  teachers       Teacher[]
  parents        Parent[]
  authorities    Authority[]
  administrators Administrator[]
  academicYears  AcademicYear[]
  subjects       Subject[]
  classes        SchoolClass[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  classes SchoolClass[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String?

  classAssignments ClassAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model SchoolClass {
  id                String       @id @default(cuid())
  schoolId          String
  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId    String
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name              String
  grade             String
  section           String
  homeroomTeacherId String?
  homeroomTeacher   Teacher?     @relation(fields: [homeroomTeacherId], references: [id])
  createdAt         DateTime     @default(now())

  enrollments     Enrollment[]
  classAssignments ClassAssignment[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([homeroomTeacherId])
}

model ClassAssignment {
  id        String      @id @default(cuid())
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([classId, subjectId])
  @@index([teacherId])
}

model Enrollment {
  id        String      @id @default(cuid())
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([studentId, classId])
  @@index([classId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  student       Student?
  teacher       Teacher?
  parent        Parent?
  authority     Authority?
  administrator Administrator?

  @@index([schoolId])
}

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  grade       String
  rollNumber  Int
  dateOfBirth DateTime
  createdAt   DateTime @default(now())

  parents     ParentStudent[]
  enrollments Enrollment[]

  @@index([schoolId])
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  subject   String
  createdAt DateTime @default(now())

  classAssignments ClassAssignment[]
  homeroomClasses  SchoolClass[]

  @@index([schoolId])
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  phone     String?
  createdAt DateTime @default(now())

  children ParentStudent[]

  @@index([schoolId])
}

model ParentStudent {
  id        String  @id @default(cuid())
  parentId  String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Authority {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  title     String
  createdAt DateTime @default(now())

  @@index([schoolId])
}

model Administrator {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  title     String
  createdAt DateTime @default(now())

  @@index([schoolId])
}
