generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  AUTHORITY
  ADMINISTRATOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
}

enum GradeType {
  ASSIGNMENT
  EXAM
  PROJECT
  PARTICIPATION
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum WellbeingEmotion {
  HAPPY
  FOCUSED
  CALM
  NEUTRAL
  TIRED
  SAD
  STRESSED
  ANXIOUS
}

enum WellbeingRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model School {
  id        String   @id @default(cuid())
  name      String
  city      String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  students       Student[]
  teachers       Teacher[]
  parents        Parent[]
  authorities    Authority[]
  administrators Administrator[]
  academicYears  AcademicYear[]
  subjects       Subject[]
  classes        SchoolClass[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  classes SchoolClass[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String?

  classAssignments ClassAssignment[]
  assignments      Assignment[]
  grades           Grade[]
  timetableSlots   TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model SchoolClass {
  id                String       @id @default(cuid())
  schoolId          String
  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId    String
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name              String
  grade             String
  section           String
  homeroomTeacherId String?
  homeroomTeacher   Teacher?     @relation(fields: [homeroomTeacherId], references: [id])
  createdAt         DateTime     @default(now())

  enrollments       Enrollment[]
  classAssignments  ClassAssignment[]
  attendanceRecords AttendanceRecord[]
  assignments       Assignment[]
  grades            Grade[]
  timetableSlots    TimetableSlot[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([homeroomTeacherId])
}

model ClassAssignment {
  id        String      @id @default(cuid())
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([classId, subjectId])
  @@index([teacherId])
}

model Enrollment {
  id        String      @id @default(cuid())
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([studentId, classId])
  @@index([classId])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId      String
  class        SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus
  reason       String?
  recordedById String?
  recordedBy   Teacher?         @relation(fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@index([studentId])
}

model Assignment {
  id          String      @id @default(cuid())
  classId     String
  class       SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  maxScore    Int         @default(100)
  createdAt   DateTime    @default(now())

  submissions AssignmentSubmission[]

  @@index([classId])
  @@index([subjectId])
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime?
  content      String?
  score        Int?
  feedback     String?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Grade {
  id        String      @id @default(cuid())
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  type      GradeType
  title     String
  score     Float
  maxScore  Float
  date      DateTime    @db.Date
  createdAt DateTime    @default(now())

  @@index([studentId])
  @@index([classId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  smsEnabled      Boolean  @default(false)
  digestFrequency String   @default("daily")
  updatedAt       DateTime @updatedAt
}

model WellbeingCheckIn {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotion        WellbeingEmotion
  confidence     Int
  stressLevel    Int                @default(50)
  riskLevel      WellbeingRiskLevel @default(LOW)
  aiResponse     String             @default("")
  recommendation String             @default("")
  source         String             @default("manual")
  createdAt      DateTime           @default(now())

  @@index([userId, createdAt])
}

model WellbeingSkip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model TimetableSlot {
  id        String      @id @default(cuid())
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  day       Weekday
  startTime String
  endTime   String
  room      String?
  createdAt DateTime    @default(now())

  @@index([classId])
  @@index([teacherId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  student       Student?
  teacher       Teacher?
  parent        Parent?
  authority     Authority?
  administrator Administrator?

  notifications           Notification[]
  notificationPreference  NotificationPreference?
  wellbeingCheckIns       WellbeingCheckIn[]
  wellbeingSkips          WellbeingSkip[]

  @@index([schoolId])
}

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  grade       String
  rollNumber  Int
  dateOfBirth DateTime
  createdAt   DateTime @default(now())

  parents           ParentStudent[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  submissions       AssignmentSubmission[]
  grades            Grade[]

  @@index([schoolId])
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  subject   String
  createdAt DateTime @default(now())

  classAssignments   ClassAssignment[]
  homeroomClasses    SchoolClass[]
  recordedAttendance AttendanceRecord[]
  assignments        Assignment[]
  grades             Grade[]
  timetableSlots     TimetableSlot[]

  @@index([schoolId])
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  phone     String?
  createdAt DateTime @default(now())

  children ParentStudent[]

  @@index([schoolId])
}

model ParentStudent {
  id        String  @id @default(cuid())
  parentId  String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Authority {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  title     String
  createdAt DateTime @default(now())

  @@index([schoolId])
}

model Administrator {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  title     String
  createdAt DateTime @default(now())

  @@index([schoolId])
}
